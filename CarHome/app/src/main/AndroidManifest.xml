<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Нужно, чтобы видеть список всех приложений на Android 11+ -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <!-- Обложки треков с памяти магнитолы (медиатека Android) -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <application
        android:label="CarHome"
        android:icon="@drawable/ic_launcher"
        android:theme="@style/Theme.CarHome"
        android:hardwareAccelerated="true">

        <!-- Главный экран -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:clearTaskOnLaunch="true"
            android:excludeFromRecents="true"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Список всех приложений -->
        <activity
            android:name=".AppsActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:screenOrientation="sensorLandscape" />

        <!-- Слушатель уведомлений: без него Android не даёт управлять чужим плеером -->
        <service
            android:name=".MediaListenerService"
            android:exported="true"
            android:label="CarHome музыка"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
