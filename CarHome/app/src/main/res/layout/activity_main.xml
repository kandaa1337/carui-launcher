<?xml version="1.0" encoding="utf-8"?>
<!-- Главный экран. Рассчитан на горизонтальные 1024x600 и 1280x720. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_flat">

    <!-- Обложка большим фоном слева. Без blur — только картинка + градиент. -->
    <ImageView
        android:id="@+id/bgArt"
        android:layout_width="640dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/art_placeholder_bg" />

    <!-- Фейд слева направо + затемнение снизу, чтобы текст читался -->
    <View
        android:layout_width="640dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@drawable/bg_art_fade" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="40dp"
        android:paddingTop="24dp"
        android:paddingEnd="28dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <!-- ===== Музыка (слева) ===== -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/sourceChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:drawableStart="@drawable/ic_music_small"
                    android:drawablePadding="6dp"
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:letterSpacing="0.08"
                    android:maxLines="1"
                    android:shadowColor="#99000000"
                    android:shadowRadius="6"
                    android:textAllCaps="true"
                    android:textColor="@color/white_70"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <!-- Пустое место сверху — тут видно обложку -->
                <Space
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <!-- Нажатие — открыть плеер, долгое — диагностика -->
                <LinearLayout
                    android:id="@+id/trackInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_item_ripple"
                    android:orientation="vertical"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp">

                    <TextView
                        android:id="@+id/trackTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:shadowColor="#99000000"
                        android:shadowRadius="10"
                        android:textColor="@color/white"
                        android:textSize="34sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/trackArtist"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:shadowColor="#99000000"
                        android:shadowRadius="8"
                        android:textColor="@color/white_70"
                        android:textSize="20sp" />
                </LinearLayout>

                <!-- Прогресс с временем -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginEnd="40dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/timeCurrent"
                        style="@style/TimeLabel"
                        android:gravity="start" />

                    <ProgressBar
                        android:id="@+id/trackProgress"
                        style="@android:style/Widget.ProgressBar.Horizontal"
                        android:layout_width="0dp"
                        android:layout_height="4dp"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="10dp"
                        android:layout_weight="1"
                        android:max="1000"
                        android:progressDrawable="@drawable/progress_track" />

                    <TextView
                        android:id="@+id/timeTotal"
                        style="@style/TimeLabel"
                        android:gravity="end" />
                </LinearLayout>

                <!-- Крупные кнопки: попасть не глядя -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginStart="-12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/btnPrev"
                        android:layout_width="88dp"
                        android:layout_height="88dp"
                        android:background="@drawable/bg_round_ripple"
                        android:contentDescription="@string/prev"
                        android:src="@drawable/ic_prev" />

                    <ImageButton
                        android:id="@+id/btnPlayPause"
                        android:layout_width="96dp"
                        android:layout_height="96dp"
                        android:layout_marginStart="32dp"
                        android:layout_marginEnd="32dp"
                        android:background="@drawable/bg_play"
                        android:contentDescription="@string/play"
                        android:elevation="6dp"
                        android:src="@drawable/ic_play" />

                    <ImageButton
                        android:id="@+id/btnNext"
                        android:layout_width="88dp"
                        android:layout_height="88dp"
                        android:background="@drawable/bg_round_ripple"
                        android:contentDescription="@string/next"
                        android:src="@drawable/ic_next" />
                </LinearLayout>

                <TextView
                    android:id="@+id/permissionHint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_hint"
                    android:paddingStart="16dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="10dp"
                    android:text="@string/grant_access"
                    android:textColor="@color/accent"
                    android:textSize="15sp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- ===== Часы и дата (справа) ===== -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginStart="24dp"
                android:gravity="end|center_vertical"
                android:orientation="vertical">

                <!-- TextClock сам обновляется раз в минуту, без таймеров в коде -->
                <TextClock
                    android:id="@+id/clock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-thin"
                    android:format12Hour="h:mm"
                    android:format24Hour="HH:mm"
                    android:includeFontPadding="false"
                    android:letterSpacing="-0.02"
                    android:textColor="@color/text_primary"
                    android:textSize="112sp" />

                <TextView
                    android:id="@+id/date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:fontFamily="sans-serif-light"
                    android:textColor="@color/text_secondary"
                    android:textSize="24sp" />
            </LinearLayout>

            <!-- ===== Громкость: вертикальная полоса, под ней mute ===== -->
            <LinearLayout
                android:layout_width="64dp"
                android:layout_height="match_parent"
                android:layout_marginStart="32dp"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <com.carhome.launcher.VolumeSlider
                    android:id="@+id/volumeBar"
                    android:layout_width="56dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <ImageButton
                    android:id="@+id/btnMute"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_mute"
                    android:contentDescription="@string/mute"
                    android:src="@drawable/ic_volume" />
            </LinearLayout>
        </LinearLayout>

        <!-- ===== Нижний док ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="76dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_dock"
            android:orientation="horizontal"
            android:padding="6dp">

            <TextView
                android:id="@+id/dockNav"
                style="@style/DockButton"
                android:drawableStart="@drawable/ic_nav"
                android:text="@string/nav" />

            <TextView
                android:id="@+id/dockMusic"
                style="@style/DockButton"
                android:drawableStart="@drawable/ic_music"
                android:text="@string/music" />

            <TextView
                android:id="@+id/dockApps"
                style="@style/DockButton"
                android:drawableStart="@drawable/ic_apps"
                android:text="@string/apps" />

            <TextView
                android:id="@+id/dockSettings"
                style="@style/DockButton"
                android:drawableStart="@drawable/ic_settings"
                android:text="@string/settings" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
