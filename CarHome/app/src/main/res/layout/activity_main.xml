<?xml version="1.0" encoding="utf-8"?>
<!-- Главный экран. Рассчитан на горизонтальные 1024x600 и 1280x720. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main"
    android:orientation="vertical"
    android:paddingStart="40dp"
    android:paddingTop="28dp"
    android:paddingEnd="40dp"
    android:paddingBottom="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- ===== Часы и дата ===== -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <!-- TextClock сам обновляется раз в минуту, без таймеров в коде -->
            <TextClock
                android:id="@+id/clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-thin"
                android:format12Hour="h:mm"
                android:format24Hour="HH:mm"
                android:includeFontPadding="false"
                android:letterSpacing="-0.02"
                android:textColor="@color/text_primary"
                android:textSize="148sp" />

            <TextClock
                android:id="@+id/date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginTop="4dp"
                android:fontFamily="sans-serif-light"
                android:format12Hour="EEEE, d MMMM"
                android:format24Hour="EEEE, d MMMM"
                android:textColor="@color/text_secondary"
                android:textSize="28sp" />

            <View
                android:id="@+id/accentLine"
                android:layout_width="56dp"
                android:layout_height="3dp"
                android:layout_marginStart="10dp"
                android:layout_marginTop="22dp"
                android:background="@drawable/accent_line" />
        </LinearLayout>

        <!-- ===== Карточка музыки: обложка на весь фон ===== -->
        <FrameLayout
            android:id="@+id/musicCard"
            android:layout_width="430dp"
            android:layout_height="410dp"
            android:layout_gravity="center_vertical"
            android:background="@drawable/bg_card"
            android:clipToOutline="true"
            android:foreground="@drawable/fg_card_stroke">

            <!-- Обложка. Без blur: размытие на слабом GPU — главный источник лагов -->
            <ImageView
                android:id="@+id/cardArt"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop"
                android:src="@drawable/art_placeholder_big" />

            <!-- Цветной отлив под цвет обложки (меняется только при смене трека) -->
            <View
                android:id="@+id/cardTint"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!-- Затемнение снизу, чтобы текст читался на любой обложке -->
            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_scrim" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingTop="20dp"
                android:paddingEnd="24dp"
                android:paddingBottom="16dp">

                <!-- Источник: из какого приложения играет -->
                <TextView
                    android:id="@+id/sourceChip"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_chip"
                    android:drawableStart="@drawable/ic_music_small"
                    android:drawablePadding="6dp"
                    android:gravity="center_vertical"
                    android:maxWidth="220dp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:paddingStart="10dp"
                    android:paddingEnd="14dp"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/trackTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:shadowColor="#80000000"
                    android:shadowRadius="8"
                    android:textColor="@color/white"
                    android:textSize="27sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/trackArtist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/white_70"
                    android:textSize="17sp" />

                <!-- Прогресс с временем -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/timeCurrent"
                        style="@style/TimeLabel"
                        android:gravity="start" />

                    <ProgressBar
                        android:id="@+id/trackProgress"
                        style="@android:style/Widget.ProgressBar.Horizontal"
                        android:layout_width="0dp"
                        android:layout_height="4dp"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="10dp"
                        android:layout_weight="1"
                        android:max="1000"
                        android:progressDrawable="@drawable/progress_track" />

                    <TextView
                        android:id="@+id/timeTotal"
                        style="@style/TimeLabel"
                        android:gravity="end" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/btnPrev"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:background="@drawable/bg_round_ripple"
                        android:contentDescription="@string/prev"
                        android:src="@drawable/ic_prev" />

                    <ImageButton
                        android:id="@+id/btnPlayPause"
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:layout_marginStart="32dp"
                        android:layout_marginEnd="32dp"
                        android:background="@drawable/bg_play"
                        android:contentDescription="@string/play"
                        android:elevation="6dp"
                        android:src="@drawable/ic_play" />

                    <ImageButton
                        android:id="@+id/btnNext"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:background="@drawable/bg_round_ripple"
                        android:contentDescription="@string/next"
                        android:src="@drawable/ic_next" />
                </LinearLayout>

                <!-- Громкость: mute одной кнопкой + ползунок -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_volume"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="4dp"
                    android:paddingEnd="14dp">

                    <ImageButton
                        android:id="@+id/btnMute"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_round_ripple"
                        android:contentDescription="@string/mute"
                        android:src="@drawable/ic_volume" />

                    <!-- Высота 48dp — чтобы удобно попадать пальцем на ходу -->
                    <SeekBar
                        android:id="@+id/volumeBar"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:maxHeight="6dp"
                        android:minHeight="6dp"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:progressDrawable="@drawable/volume_track"
                        android:splitTrack="false"
                        android:thumb="@drawable/volume_thumb" />

                    <TextView
                        android:id="@+id/volumeValue"
                        android:layout_width="40dp"
                        android:layout_height="wrap_content"
                        android:fontFeatureSettings="tnum"
                        android:gravity="end"
                        android:textColor="@color/white_70"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Показывается поверх всего, если нет доступа к плеерам -->
            <TextView
                android:id="@+id/permissionHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="top"
                android:layout_margin="16dp"
                android:background="@drawable/bg_hint"
                android:gravity="center"
                android:padding="12dp"
                android:text="@string/grant_access"
                android:textColor="@color/accent"
                android:textSize="15sp"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <!-- ===== Нижний док ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_dock"
        android:orientation="horizontal"
        android:padding="8dp">

        <TextView
            android:id="@+id/dockNav"
            style="@style/DockButton"
            android:drawableStart="@drawable/ic_nav"
            android:text="@string/nav" />

        <TextView
            android:id="@+id/dockMusic"
            style="@style/DockButton"
            android:drawableStart="@drawable/ic_music"
            android:text="@string/music" />

        <TextView
            android:id="@+id/dockApps"
            style="@style/DockButton"
            android:drawableStart="@drawable/ic_apps"
            android:text="@string/apps" />

        <TextView
            android:id="@+id/dockSettings"
            style="@style/DockButton"
            android:drawableStart="@drawable/ic_settings"
            android:text="@string/settings" />
    </LinearLayout>
</LinearLayout>
